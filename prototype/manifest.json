{
  "manifest_version": 3,
  "name": "Arth (local)",
  "version": "0.3.0",
  "description": "Select text on any page to get a short explanation in context, or ask your own question. Local build: answers come from a background ChatGPT tab.",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/frames.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/adapter.js",
        "src/context.js",
        "src/vocab.js",
        "src/reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/worker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ask Arth about this page"
  },
  "options_ui": {
    "page": "src/words.html",
    "open_in_tab": true
  }
}
